@app.post("/debug-set-kyc/{pi_uid}")
async def debug_set_kyc(pi_uid: str):
    """Set kyc_verified=True for a given pi_uid (admin only, dev)."""
    from app.backend.core.database import db_manager
    from app.backend.models.pi_profiles import Pi_profiles
    from sqlalchemy import select
    async with db_manager.async_session_maker() as db:
        profile = (await db.execute(select(Pi_profiles).where(Pi_profiles.pi_uid == pi_uid))).scalars().first()
        if not profile:
            return {"status": "error", "msg": "profile not found"}
        profile.kyc_verified = True
        await db.commit()
        return {"status": "ok", "pi_uid": pi_uid, "kyc_verified": True}




@app.post("/debug-vote-batch/{pi_uid}")
async def debug_vote_batch(pi_uid: str):
    """Admin: batch vote on all projects for testing."""
    from app.backend.core.database import db_manager
    from app.backend.models.pi_profiles import Pi_profiles
    from app.backend.models.votes import Votes
    from app.backend.models.projects import Projects
    from sqlalchemy import select, update
    import datetime

    async with db_manager.async_session_maker() as db:
        profile = (await db.execute(select(Pi_profiles).where(Pi_profiles.pi_uid == pi_uid))).scalars().first()
        if not profile:
            return {"status": "error", "msg": "profile not found"}

        projects = (await db.execute(select(Projects).order_by(Projects.id))).scalars().all()
        created = 0
        for proj in projects:
            existing = (await db.execute(
                select(Votes).where(Votes.project_id == proj.id, Votes.pi_uid == pi_uid)
            )).scalars().first()
            if existing:
                continue
            v = Votes(
                project_id=proj.id,
                vote_type="for",
                weight=10.0,
                pi_uid=pi_uid,
                user_id=pi_uid,
                created_at=datetime.datetime.utcnow(),
                updated_at=datetime.datetime.utcnow(),
            )
            db.add(v)
            proj.votes_for = (proj.votes_for or 0) + 10
            proj.voter_count = (proj.voter_count or 0) + 1
            created += 1
        await db.commit()
        return {"status": "ok", "created": created, "total_projects": len(projects)}




@app.post("/debug-simulate-funding/{pi_uid}")
async def debug_simulate_funding(pi_uid: str):
    """Admin: simulate 5 completed contributions for testing."""
    from app.backend.core.database import db_manager
    from app.backend.models.pi_profiles import Pi_profiles
    from app.backend.models.contributions import Contributions
    from app.backend.models.projects import Projects
    from sqlalchemy import select
    import datetime

    async with db_manager.async_session_maker() as db:
        profile = (await db.execute(select(Pi_profiles).where(Pi_profiles.pi_uid == pi_uid))).scalars().first()
        if not profile:
            return {"status": "error", "msg": "profile not found"}

        projects = (await db.execute(select(Projects).order_by(Projects.id).limit(5))).scalars().all()
        created = 0
        for proj in projects:
            existing = (await db.execute(
                select(Contributions).where(
                    Contributions.project_id == proj.id,
                    Contributions.pi_uid == pi_uid,
                    Contributions.status == "completed"
                )
            )).scalars().first()
            if existing:
                continue
            c = Contributions(
                project_id=proj.id,
                amount=100.0,
                transaction_id=f"sim_{proj.id}_{pi_uid[:8]}",
                payment_id=f"sim_{proj.id}",
                status="completed",
                pi_uid=pi_uid,
                user_id=pi_uid,
                created_at=datetime.datetime.utcnow(),
                updated_at=datetime.datetime.utcnow(),
            )
            db.add(c)
            proj.raised = (proj.raised or 0) + 100.0
            created += 1
        await db.commit()
        return {"status": "ok", "created": created, "total_projects": len(projects)}




@app.post("/debug-simulate-comments/{pi_uid}")
async def debug_simulate_comments(pi_uid: str):
    """Admin: simulate comments and likes for community trust."""
    from app.backend.core.database import db_manager
    from app.backend.models.pi_profiles import Pi_profiles
    from app.backend.models.comments import Comments
    from app.backend.models.projects import Projects
    from sqlalchemy import select
    import datetime

    async with db_manager.async_session_maker() as db:
        profile = (await db.execute(select(Pi_profiles).where(Pi_profiles.pi_uid == pi_uid))).scalars().first()
        if not profile:
            return {"status": "error", "msg": "profile not found"}

        projects = (await db.execute(select(Projects).order_by(Projects.id).limit(5))).scalars().all()
        created = 0
        for proj in projects:
            existing = (await db.execute(
                select(Comments).where(Comments.project_id == proj.id, Comments.pi_uid == pi_uid)
            )).scalars().first()
            if existing:
                continue
            c = Comments(
                project_id=proj.id,
                content=f"Great project! {proj.title} is exactly what Atlasphere needs.",
                pi_uid=pi_uid,
                pi_username=profile.username,
                likes=20,
                parent_id=None,
                created_at=datetime.datetime.utcnow(),
                updated_at=datetime.datetime.utcnow(),
            )
            db.add(c)
            created += 1
        await db.commit()
        return {"status": "ok", "created": created, "total_projects": len(projects)}




@app.post("/debug-add-avatar-column")
async def debug_add_avatar_column():
    from app.backend.core.database import db_manager
    from sqlalchemy import text
    try:
        async with db_manager.async_session_maker() as db:
            await db.execute(text("ALTER TABLE pi_profiles ADD COLUMN IF NOT EXISTS avatar VARCHAR"))
            await db.commit()
            return {"status": "ok", "message": "avatar column added"}
    except Exception as e:
        return {"status": "error", "msg": str(e)}




@app.post("/debug-set-member-since/{pi_uid}")
async def debug_set_member_since(pi_uid: str, days_ago: int = 180):
    """Admin: update the created_at of a profile to simulate an older member."""
    from app.backend.core.database import db_manager
    from app.backend.models.pi_profiles import Pi_profiles
    from sqlalchemy import select
    import datetime
    try:
        async with db_manager.async_session_maker() as db:
            profile = (await db.execute(select(Pi_profiles).where(Pi_profiles.pi_uid == pi_uid))).scalars().first()
            if not profile:
                return {"status": "error", "msg": "profile not found"}
            new_date = datetime.datetime.utcnow() - datetime.timedelta(days=days_ago)
            profile.created_at = new_date
            await db.commit()
            return {"status": "ok", "pi_uid": pi_uid, "new_created_at": new_date.isoformat()}
    except Exception as e:
        return {"status": "error", "msg": str(e)}


