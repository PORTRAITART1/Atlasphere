VITE_APP_TITLE=Atlasphere
VITE_APP_DESCRIPTION=Gouvernance décentralisée pour Pi Network. Votez, financez et construisez l'avenir de votre communauté.
VITE_APP_LOGO_URL=/assets/logo-atlasphere-transparent.png

# Administrateurs Atlasphere (noms d'utilisateur Pi Network, séparés par une virgule,
# insensible à la casse). Seuls ces comptes peuvent ouvrir /settings et /admin.
VITE_ADMIN_USERNAMES=portraitart

# Mode réseau du Pi SDK v2.0.
# false (défaut) = paiements réels dans Pi Browser (Testnet/Mainnet selon la clé serveur PI_API_KEY).
# true = uniquement pour tester dans l'environnement web Pi Sandbox.
VITE_PI_SANDBOX=false