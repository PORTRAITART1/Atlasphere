# Frontend environment variables — EXAMPLE
# Copy this file to .env and fill in the values.

VITE_APP_TITLE=Atlasphere
VITE_APP_DESCRIPTION=Gouvernance décentralisée pour Pi Network. Votez, financez et construisez l'avenir de votre communauté.
VITE_APP_LOGO_URL=/icons/icon-192.png

# Pi Network SDK mode. Defaults to sandbox/Testnet; set false only for Mainnet builds.
VITE_PI_SANDBOX=true
